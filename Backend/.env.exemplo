# Arquivo de exemplo com valores estritamente ficticios (copie para .env local)
LUME_AMBIENTE=desenvolvimento
LUME_NOME_SERVICO=lume-api
LUME_VERSAO_API=0.1.0
LUME_ORIGENS_CORS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL 18 (desenvolvimento e teste isolado)
LUME_POSTGRES_URL=postgresql+psycopg://usuario_ficticio:senha_ficticia@127.0.0.1:5432/lume_dev
LUME_POSTGRES_TESTE_URL=postgresql+psycopg://usuario_ficticio:senha_ficticia@127.0.0.1:5432/tarefas_teste

# MongoDB 8.2 (desenvolvimento e teste isolado)
LUME_MONGO_URL=mongodb://127.0.0.1:27017
LUME_MONGO_BANCO=lume_dev
LUME_MONGO_BANCO_TESTE=tarefas_teste

# Google OAuth 2.0 e sessao
LUME_GOOGLE_CLIENT_ID=000000000000-exemplo_ficticio.apps.googleusercontent.com
LUME_GOOGLE_CLIENT_SECRET=segredo_ficticio_oauth
LUME_GOOGLE_REDIRECT_URI=http://localhost:5173/api/autenticacao/google/callback
LUME_SEGREDO_SESSAO=chave_ficticia_para_desenvolvimento_com_32_bytes_minimos

# Lembretes internos e Web Push VAPID
LUME_TOKEN_INTERNO_LEMBRETES=token_interno_ficticio_cron
LUME_VAPID_CHAVE_PUBLICA=chave_vapid_publica_ficticia
LUME_VAPID_CHAVE_PRIVADA=chave_vapid_privada_ficticia
LUME_VAPID_ASSUNTO=mailto:exemplo@lume.local
